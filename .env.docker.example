# RazorGrowth AI - Docker Environment Configuration
# Copy this file to .env and fill in your credentials

# Razorpay Test Mode Credentials
# Get your test keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# AI/LLM Provider API Keys
# At least one provider is required for agent reasoning

# OpenRouter (Recommended - supports multiple models)
# Get API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# NVIDIA NIM (Optional - for tool calling)
# Get API key from: https://build.nvidia.com/
NVIDIA_NIM_API_KEY=

# Groq (Optional - for fast streaming)
# Get API key from: https://console.groq.com/
GROQ_API_KEY=

# Mistral (Optional - backup provider)
# Get API key from: https://console.mistral.ai/
MISTRAL_API_KEY=

# Database Configuration (automatically set by docker-compose)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/razorgrowth

# Application Settings (automatically set by docker-compose)
# APP_NAME="RazorGrowth AI"
# ENVIRONMENT="development"
# DEBUG="True"
